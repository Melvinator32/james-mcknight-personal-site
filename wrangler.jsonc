{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "james-mcknight-personal-site",
  "compatibility_date": "2026-08-31",
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
